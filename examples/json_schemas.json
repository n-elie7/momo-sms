    "created_at": "2024-05-10T16:31:00Z"
  },

  "full_transaction": {
    "_comment": "Composite object — how a single transaction looks when joined with its category, participants, and source SMS for API responses. Demonstrates nesting of related data.",
    "transaction_id": 5,
    "external_tx_ref": null,
    "financial_tx_id": "14098463509",
    "amount": 20000.00,
    "fee": 350.00,
    "currency": "RWF",
    "new_balance": 6400.00,
    "tx_timestamp": "2024-05-26T02:10:27Z",
    "status": "completed",
    "token": null,
    "message_note": "Agent withdrawal",
    "category": {
      "category_id": 5,
      "category_code": "WITHDRAWAL_AGENT",
      "category_name": "Agent withdrawal",
      "direction": "debit"
    },
    "participants": [
      {
        "role": "sender",
        "user": {
          "user_id": 1,
          "full_name": "Account Holder",
          "account_number": "36521838",
          "user_type": "self"
        }
      },
      {
        "role": "agent",
        "user": {
          "user_id": 7,
          "full_name": "Agent Sophia",
          "phone_number": "250795963036",
          "user_type": "agent"
        }
      }
    ],
    "source_sms": {
      "raw_sms_id": 5,
      "sms_address": "M-Money",
      "readable_date": "26 May 2024 2:10:34 AM",
      "body": "You Abebe Chala CHEBUDIE have via agent: Agent Sophia (250790777777), withdrawn 20000 RWF from your mobile money account: 36521838 at 2024-05-26 02:10:27. Your new balance: 6400 RWF. Fee paid: 350 RWF. Financial Transaction Id: 14098463509."
    },
    "processing_logs": [
      {
        "log_level": "INFO",
        "stage": "parse",
        "message": "Withdrawal parsed: 2 participants linked",
        "created_at": "2024-05-26T02:10:35Z"
      }
    ]
  },

  "sql_to_json_mapping": {
    "_comment": "Reference table mapping SQL columns to JSON keys. Useful for the API serialisation layer.",
    "users": {
      "user_id": "user.user_id (integer)",
      "full_name": "user.full_name (string)",
      "phone_number": "user.phone_number (string|null)",
      "user_type": "user.user_type (enum string)"
    },
    "transactions": {
      "transaction_id": "transaction.transaction_id (integer)",
      "amount": "transaction.amount (number, 2dp)",
      "fee": "transaction.fee (number, 2dp)",
      "tx_timestamp": "transaction.tx_timestamp (ISO-8601 string)",
      "category_id": "nested as transaction.category (object)",
      "raw_sms_id": "nested as transaction.source_sms (object)"
    },
    "transaction_participants": {
      "_comment": "This junction table is NOT exposed as a top-level JSON resource; it becomes the 'participants' array nested inside a transaction."
    },
    "transaction_categories": {
      "_comment": "Embedded inside each transaction as the 'category' object (rather than referenced by id) for API convenience."
    },
    "system_logs": {
      "_comment": "Optionally embedded as 'processing_logs' on a transaction when admin/debug views are requested."
    }
  }
}
